 # ============================================================
# NEXORA — Environment Variables Template for Vercel Deployment
# Copy this to .env.local for local development
# Add these in Vercel Project Settings > Environment Variables
# ============================================================

# --- Firebase Configuration ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gdgvizag-4c54e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gdgvizag-4c54e
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=gdgvizag-4c54e.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=88453910197
NEXT_PUBLIC_FIREBASE_APP_ID=1:88453910197:web:66e748e7618c5ef3e778fc
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-GPQSQHBJYY

# --- AI Provider (Google Gemini) ---
GEMMA_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# --- Twilio Voice & WhatsApp Telephony Engine ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# --- App URL (Set to your Vercel URL after deployment) ---
APP_URL=https://your-nexora-app.vercel.app
